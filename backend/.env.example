# ---------- MediSense AI backend configuration ----------
# Copy this file to `.env` (same folder) and fill in the values.

# REQUIRED: Google Gemini API key  ->  https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# REQUIRED: MongoDB connection string.
#   Local:  mongodb://localhost:27017
#   Atlas:  mongodb+srv://<user>:<password>@<cluster>.mongodb.net
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB=medisense

# REQUIRED: long random secret used to sign JWTs (>= 32 chars).
#   Generate one:  python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Gemini models (defaults are fine)
GEMINI_MODEL=gemini-2.5-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-001

# OPTIONAL: full path to tesseract.exe if it is not on PATH
#   e.g. C:\Program Files\Tesseract-OCR\tesseract.exe
TESSERACT_CMD=
OCR_DPI=300

# Frontend origin allowed by CORS (comma-separated for several)
FRONTEND_ORIGIN=http://localhost:3000

# Storage (relative to backend/ by default)
# UPLOAD_DIR=uploads
# CHROMA_DIR=chroma_db
MAX_UPLOAD_MB=25

# RAG tuning
CHUNK_SIZE=900
CHUNK_OVERLAP=150
RAG_TOP_K=5
